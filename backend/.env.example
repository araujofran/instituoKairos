SCHOOL_ENVIRONMENT=development
SCHOOL_DATABASE_URL=postgresql+psycopg://school:local-development-only@localhost:5432/school
# Copie o issuer e a URL JWKS do provedor real; nunca use tokens de teste em produção.
# SCHOOL_AUTH_ISSUER=https://PROJECT.supabase.co/auth/v1
# SCHOOL_AUTH_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SCHOOL_AUTH_AUDIENCE=authenticated
SCHOOL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Login local, uploads privados e limites da configuração inicial.
SCHOOL_LOCAL_AUTH_ENABLED=true
SCHOOL_MAX_UPLOAD_BYTES=268435456
SCHOOL_UPLOAD_QUOTA_BYTES=5368709120
# SCHOOL_UPLOAD_DIRECTORY=/var/lib/kairos/uploads
